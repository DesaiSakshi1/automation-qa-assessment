# Copy to .env and fill in. .env is gitignored.
# Discord channel webhook (Server Settings > Integrations > Webhooks > Copy URL)
DISCORD_WEBHOOK_URL=
# Optional: GitHub token (no scopes needed) to raise the Search API rate limit
GITHUB_TOKEN=
# Local-only secrets for the RealWorld stack
POSTGRES_PASSWORD=
JWT_SECRET=
# Local n8n owner account (created on first run)
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
