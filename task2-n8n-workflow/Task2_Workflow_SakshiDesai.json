    {
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "// One Discord message (max 2000 chars) with a Breakout and a Rising section.\nconst repos = $input.all().map((i) => i.json).sort((a, b) => b.stars - a.stars);\nconst line = (r) => `**[${r.name}](<${r.url}>)** ⭐ ${r.stars} · ${r.language} · created ${r.created_at}\\n> ${r.summary ?? r.description}`;\nconst breakout = repos.filter((r) => r.section === 'breakout');\nconst rising = repos.filter((r) => r.section === 'rising');\nconst failed = repos.filter((r) => r.readmeError);\n\nlet content = '☀️ **Morning brief: new LLM repos on GitHub (last 7 days)**';\nif (breakout.length) content += '\\n\\n🔥 **Breakout (≥ 1000 ⭐)**\\n' + breakout.map(line).join('\\n');\nif (rising.length) content += '\\n\\n🌱 **Rising**\\n' + rising.map(line).join('\\n');\nif (failed.length) content += `\\n\\n⚠️ README unavailable for ${failed.length} repo(s), showing the GitHub description instead (${failed.map((f) => `${f.name}: ${f.readmeError}`).join('; ')})`;\nif (content.length > 2000) content = content.slice(0, 1997) + '…';\n\nreturn [{ json: { content, repos: repos.length, breakout: breakout.length, readmeFailures: failed.length } }];"
      }
    },
