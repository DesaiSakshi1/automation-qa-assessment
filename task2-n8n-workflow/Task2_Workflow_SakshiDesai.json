      "position": [
        240,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "url": "https://api.github.com/search/repositories",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "=topic:llm created:>{{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "sort",
              "value": "stars"
            },
            {
              "name": "order",
              "value": "desc"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Top 5 + reshape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Keep the 5 most-starred repos and only the fields the digest needs.\nconst repos = $input.first().json.items ?? [];\nif (repos.length === 0) throw new Error('GitHub search returned 0 repositories (expected thousands for a 7-day window)');\n\nreturn repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5)\n  .map((r) => ({ json: {\n    name: r.full_name,\n    url: r.html_url,\n    stars: r.stargazers_count,\n    language: r.language ?? 'n/a',\n    description: (r.description ?? '').trim() || 'No description',\n    created_at: r.created_at.slice(0, 10),\n  } }));"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "GitHub: fetch README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.name }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "readme"
            }
          }
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Add README summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "// Pair each README response with its repo (same order) and keep a short plain-text summary.\n// A failed README call arrives here as an item with `error` (graceful degradation).\nconst repos = $('Top 5 + reshape').all();\n\nfunction summarize(md) {\n  const paragraph = md\n    .replace(/```[\\s\\S]*?```/g, ' ')           // code blocks\n    .replace(/<[^>]+>/g, ' ')                    // html tags (badges, images)\n    .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, ' ')        // markdown images\n    .replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g, '$1')       // links -> text\n    .split(/\\n\\s*\\n/)\n    .map((p) => p.replace(/^#+\\s.*$/gm, '').replace(/[*_`>|]/g, ' ').replace(/\\s+/g, ' ').trim())\n    .find((p) => p.length > 40 && /[.!?]/.test(p)); // a real sentence, not a row of nav links\n  if (!paragraph) return null;\n  return paragraph.length > 160 ? paragraph.slice(0, 157) + '…' : paragraph;\n}\n\nreturn $input.all().map((item, i) => {\n  const readme = typeof item.json.readme === 'string' ? item.json.readme : null;\n  return { json: {\n    ...repos[i].json,\n    summary: readme ? summarize(readme) : null,\n    readmeError: readme ? null : (item.json.error?.message ?? 'README missing'),\n  } };\n});"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Stars ≥ 1000?",
