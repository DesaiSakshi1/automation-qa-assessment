    {
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Format degraded alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// The GitHub search failed after 3 tries: tell the channel instead of failing silently.\nconst e = $input.first().json.error ?? {};\nconst status = e.httpCode ?? e.status ?? 'no HTTP status';\nconst content = `⚠️ **Morning brief degraded**: \\`GitHub: search new LLM repos\\` failed after 3 tries with ${status} / ${String(e.message ?? 'unknown error').replace(/\\s+/g, ' ').slice(0, 200)}. No digest this run; next try in 1 hour. (execution ${$execution.id})`;\nreturn [{ json: { content } }];"
      }
    },
